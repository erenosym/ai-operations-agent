# Local development defaults only. Copy to .env when running Docker Compose.
POSTGRES_DB=operations
POSTGRES_USER=operations
POSTGRES_PASSWORD=operations

# Compose database URL. Keep credentials/database in sync with POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://operations:operations@postgres:5432/operations

# Local tool-capable Ollama model used by the LLM provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
FRONTEND_ORIGIN=http://localhost:5173

# Compose uses a separate override so host development keeps localhost Ollama.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
POSTGRES_PORT=5432
API_PORT=8001
FRONTEND_PORT=5173
